{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "threshold": 0.7
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama P920",
      "options": {
        "baseURL": "http://192.168.0.104:11434/v1"
      },
      "models": {
        "devstral-small-2:latest": {
          "name": "Devstral Small 2 GPU2",
          "tools": true
        },
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B GPU2",
          "tools": true
        },
        "qwen3-coder-next:latest": {
          "name": "Qwen3 Coder Next GPU2",
          "tools": true
        },
        "qwen3.6:35b-a3b": {
          "name": "Qwen 3.6 35B-A3B GPU2",
          "tools": true
        },
        "qwen3.6:27b": {
          "name": "Qwen 3.6 27B GPU2",
          "tools": true
        },
        "gemma4:e2b": {
          "name": "Gemma 4 e2b GPU2",
          "tools": true
        },
        "gemma4:12b": {
          "name": "Gemma 4 12B GPU2",
          "tools": true
        }
      }
    },
    "ollama-gx10": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama GX10",
      "options": {
        "baseURL": "http://192.168.0.106:11434/v1"
      },
      "models": {
        "qwen3-coder:30b": { "name": "Qwen3 Coder 30B GX10", "tools": true },
        "devstral-small-2:latest": { "name": "Devstral Small 2 GX10", "tools": true },
        "qwen3.5:35b": { "name": "Qwen3.5 35B GX10", "tools": true },
        "qwen3.6:35b-a3b": { "name": "Qwen 3.6 35B-A3B GX10", "tools": true },
        "qwen3-coder-next:latest": { "name": "Qwen3 Coder Next GX10", "tools": true },
        "gemma4:31b": { "name": "Gemma 4 31B Dense GX10", "tools": true },
        "gemma4:26b": { "name": "Gemma 4 26B MoE GX10", "tools": true }
      }
