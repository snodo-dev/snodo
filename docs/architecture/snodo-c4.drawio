          <mxGeometry x="1360" y="410" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="l2ext3" value="&lt;b&gt;Git worktrees&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GitHub&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1360" y="740" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="l2chan1" value="channel A" style="text;html=1;fontSize=9;fontColor=#C8C8C8;align=left;" vertex="1" parent="1">
          <mxGeometry x="1252" y="268" width="80" height="14" as="geometry" />
        </mxCell>
