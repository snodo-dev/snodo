        <mxCell id="l2ext1" value="&lt;b&gt;LLM providers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;via litellm&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;verticalAlign=top;spacing=6;" vertex="1" parent="1">
