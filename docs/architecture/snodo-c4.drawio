<mxfile host="app.diagrams.net" agent="snodo-architecture" version="24.0.0">
  <diagram id="c4-l1" name="L1 · System Context">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="l1title" value="snodo — C4 Level 1 · System Context" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l1sub" value="snodo is a protocol engine. It does not aim to be a coder — it constrains and audits whoever writes the code." style="text;html=1;fontSize=12;fontColor=#555555;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="l1op" value="&lt;b&gt;Operator / Engineer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Writes task specs, chooses protocol and mode, reviews halt payloads, authorises decisions.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="100" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="l1snodo" value="&lt;b&gt;snodo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Policy/mechanism protocol engine. Compiles a protocol, binds capability to the active mode, runs a bounded execute/validate loop, and writes a hash-chained audit trail.&lt;br&gt;&lt;br&gt;Invariants INV1–INV5 · well-formedness WF1′–WF5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="320" width="300" height="180" as="geometry" />
        </mxCell>

        <mxCell id="l1agent" value="&lt;b&gt;External agent / IDE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Drives snodo over MCP (stdio / SSE) instead of the CLI.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="140" y="350" width="220" height="120" as="geometry" />
        </mxCell>

        <mxCell id="l1cloud" value="&lt;b&gt;snodo Cloud&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[External System] optional&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Audit batch sync with a per-session cursor.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3B3B3;strokeColor=#6B6B6B;fontColor=#ffffff;verticalAlign=top;spacing=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="350" width="220" height="120" as="geometry" />
        </mxCell>

        <mxCell id="l1repo" value="&lt;b&gt;Target project repository&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;The repo being worked on. Isolated per task via a git worktree.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="120" y="690" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="l1git" value="&lt;b&gt;Git remote / GitHub&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Branches, merges, PRs and issues (PyGithub).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="400" y="690" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="l1llm" value="&lt;b&gt;LLM providers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[External System] via litellm&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Used by the built-in coder AND by every LLM validator and the classifier.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="690" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="l1oc" value="&lt;b&gt;opencode&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;An expert coding CLI. Host subprocess, or a Docker container serving HTTP/SSE. Brings its own agent loop, context management and credentials.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="690" width="280" height="120" as="geometry" />
        </mxCell>

        <mxCell id="l1busn" value="routing channel" style="text;html=1;fontSize=9;fontColor=#BBBBBB;align=left;" vertex="1" parent="1">
          <mxGeometry x="1250" y="590" width="120" height="14" as="geometry" />
        </mxCell>

        <mxCell id="l1e1" value="runs tasks · reads halts · authorises" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="l1op" target="l1snodo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="l1e7" value="MCP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1agent" target="l1snodo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="l1e6" value="audit sync" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;fontSize=10;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1snodo" target="l1cloud">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="l1e2" value="reads · writes · branches · merges" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;fontSize=10;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="l1snodo" target="l1repo">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="680" y="610" />
              <mxPoint x="245" y="610" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="l1e3" value="push · PR · issues" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;fontSize=10;exitX=0.47;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="l1snodo" target="l1git">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="701" y="630" />
              <mxPoint x="525" y="630" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="l1e4" value="completions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;fontSize=10;exitX=0.54;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="l1snodo" target="l1llm">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="722" y="630" />
              <mxPoint x="805" y="630" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="l1e5" value="delegates code generation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;fontSize=10;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="l1snodo" target="l1oc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="740" y="610" />
              <mxPoint x="1100" y="610" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="l1note" value="&lt;b&gt;Design intent.&lt;/b&gt; The coder is pluggable and deliberately not snodo's differentiator. An expert CLI (opencode) is the preferred generator; the built-in litellm coder exists so snodo works with no CLI installed. snodo's job is that the protocol's checks and balances hold &lt;i&gt;regardless of who generated the change&lt;/i&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="120" y="840" width="1120" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="c4-l2" name="L2 · Containers">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="l2title" value="snodo — C4 Level 2 · Containers" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l2sub" value="Layering is enforced executably by import-linter (.importlinter):  core ← tools ← foundation ← engine ← mcp ← app.  Six contracts, currently 0 broken.  Arrows are routed through the gutters between layers." style="text;html=1;fontSize=12;fontColor=#555555;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1300" height="20" as="geometry" />
        </mxCell>

        <mxCell id="l2b" value="snodo" style="rounded=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacing=8;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1210" height="750" as="geometry" />
        </mxCell>

        <mxCell id="l2app" value="app · snodo.cli / snodo.dashboard / snodo.agents" style="rounded=0;fillColor=none;strokeColor=#D0D0D0;dashed=1;verticalAlign=top;align=left;spacing=6;fontSize=10;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="1170" height="130" as="geometry" />
        </mxCell>
        <mxCell id="l2cli" value="&lt;b&gt;CLI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: Typer]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;run · validate · mode · session · task · plan · worktree · authorize · init · recon · job · agent · models · config · status · serve&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="l2tui" value="&lt;b&gt;Dashboard TUI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: Textual]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Panels · screens · providers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="150" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="l2mcpsrv" value="&lt;b&gt;MCP Server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: MCP SDK · stdio/SSE]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Exposes snodo to external agents. Job, decision, model, recon, planner and PR handlers.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="690" y="150" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="l2agents" value="&lt;b&gt;Agent runners&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;snodo.agents&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1010" y="150" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="l2eng" value="engine · snodo.engine / snodo.validators / snodo.coders" style="rounded=0;fillColor=none;strokeColor=#D0D0D0;dashed=1;verticalAlign=top;align=left;spacing=6;fontSize=10;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="1170" height="140" as="geometry" />
        </mxCell>
        <mxCell id="l2loop" value="&lt;b&gt;Execution Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: LangGraph]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;governance → pre-validate → execute → post-validate → writeback. Kleene-closure recovery; four halt outcomes.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="340" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="l2val" value="&lt;b&gt;Validator Subsystem&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;LLM judges (architecture · security · meta-spec · acceptance) + quality, the only validator that executes a command.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="340" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="l2coder" value="&lt;b&gt;Coder Adapters&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;LiteLLM tool loop · opencode CLI · opencode container · mock. Selected by model-string prefix.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="800" y="340" width="410" height="100" as="geometry" />
        </mxCell>

        <mxCell id="l2fnd" value="foundation · snodo.compiler / snodo.protocols / snodo.infrastructure" style="rounded=0;fillColor=none;strokeColor=#D0D0D0;dashed=1;verticalAlign=top;align=left;spacing=6;fontSize=10;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="60" y="510" width="1170" height="140" as="geometry" />
        </mxCell>
        <mxCell id="l2comp" value="&lt;b&gt;Protocol Compiler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: Pydantic]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Protocol / Mode / ExecutionConfig models · WF1′–WF5 verifier · shipped templates (solo, team, 2+n, greenfield…)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="540" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="l2gov" value="&lt;b&gt;Governance Infrastructure&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Audit hash-chain (INV4) · Sessions (INV5) · Token issuer JWT (INV1) · Decisions · Signing keys · JWKS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="540" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="l2runtime" value="&lt;b&gt;Run-time Services&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Worktree manager · Environment prep · Wave registry · Model resolver / catalog · Usage tracker · Checkpoint memory · Cloud sync&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="800" y="540" width="410" height="100" as="geometry" />
        </mxCell>

        <mxCell id="l2low" value="tools · snodo.tools / snodo.providers          core · snodo.core / config / paths / project / predicates / sandbox" style="rounded=0;fillColor=none;strokeColor=#D0D0D0;dashed=1;verticalAlign=top;align=left;spacing=6;fontSize=10;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="1170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="l2mcp" value="&lt;b&gt;Tool MCPs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;WorkspaceMCP (path validation, .snodo/ refusal) · GitMCP · ShellMCP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="730" width="330" height="80" as="geometry" />
        </mxCell>
