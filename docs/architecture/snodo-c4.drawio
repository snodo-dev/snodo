        <mxCell id="c3t" value="L3 · Coder Subsystem  (snodo.coders)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c3s" value="Selection is by model-string prefix only — there is no --coder flag.   coders/__init__.py:46-56" style="text;html=1;fontSize=12;fontColor=#555555;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1000" height="20" as="geometry" />
        </mxCell>

        <mxCell id="c3sel" value="&lt;b&gt;resolve_adapter_class(model)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;gpt|o1|o3 → OpenAI · claude → Anthropic&lt;br&gt;gemini|google/ → Gemini&lt;br&gt;opencode-cli/ → CLI · opencode/ → container&lt;br&gt;else → LiteLLM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="290" height="100" as="geometry" />
        </mxCell>

        <mxCell id="c3abc" value="&lt;b&gt;Coder (ABC)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;snodo.core.interfaces — aliased CoderAdapter&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;implement(spec: TaskSpec) → CodeArtifact&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;verticalAlign=top;spacing=6;align=center;" vertex="1" parent="1">
          <mxGeometry x="480" y="100" width="360" height="100" as="geometry" />
        </mxCell>

        <mxCell id="c3flags" value="&lt;b&gt;Engine ↔ adapter coupling&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;opt-out flags: skip_workspace_write · skip_engine_commit&lt;br&gt;duck-typed: progress_callback · _job_id · _task_id&lt;br&gt;&lt;b&gt;all hasattr-guarded → absence is silent&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="990" y="100" width="350" height="100" as="geometry" />
        </mxCell>

        <mxCell id="c3litellm" value="&lt;b&gt;LiteLLMAdapter&lt;/b&gt;   &lt;font style=&quot;font-size:10px&quot;&gt;litellm.py — 655 lines · the built-in fallback coder&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="620" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c3lgrp" value="" style="rounded=0;fillColor=none;strokeColor=#D0D0D0;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="620" height="290" as="geometry" />
        </mxCell>
        <mxCell id="c3loop" value="&lt;b&gt;_call_llm_with_tools&lt;/b&gt; — bounded tool loop&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;max_tool_turns: config default 6 (adapter default 20)&lt;br&gt;tools: read_file · read_file_lines · list_files&lt;br&gt;terminal: submit_files(files=[{path, content, action}])&lt;br&gt;&lt;b&gt;no write tool, no shell&lt;/b&gt; — the executor owns writes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B1D8F5;strokeColor=#5D82A8;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="345" width="290" height="115" as="geometry" />
        </mxCell>
        <mxCell id="c3ceiling" value="&lt;b&gt;max_tokens ceiling&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Every file's full content is generated as &lt;b&gt;output tokens&lt;/b&gt; inside one submit_files call, bounded by max_tokens (default 16000).&lt;br&gt;&lt;br&gt;finish_reason ∈ {length, max_tokens} → ParseError &quot;task is too large&quot;.&lt;br&gt;&lt;b&gt;A hard ceiling on task size.&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="370" y="345" width="270" height="115" as="geometry" />
        </mxCell>
        <mxCell id="c3feat" value="&lt;b&gt;Current on:&lt;/b&gt; progress_callback (#51) · tool-response invariant, every tool_call_id answered, zero-file submit refused (#53) · truncation detection (#39) · UsageTracker cost + tokens per call · api_base and CF affinity headers · Gemini-3 temperature drop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;spacing=6;align=left;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="475" width="580" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c3subs" value="&lt;b&gt;OpenAIAdapter · AnthropicAdapter · GeminiAdapter&lt;/b&gt; — thin subclasses of LiteLLMAdapter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B1D8F5;strokeColor=#5D82A8;spacing=6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="548" width="580" height="35" as="geometry" />
        </mxCell>
        <mxCell id="c3mock" value="&lt;b&gt;MockAdapter&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;— hermetic _completion_fn · set_mock_mode · is_mock_mode_active (#12)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B1D8F5;strokeColor=#5D82A8;spacing=6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="590" width="580" height="20" as="geometry" />
        </mxCell>

        <mxCell id="c3inplace" value="&lt;b&gt;InPlaceCoderAdapter (ABC)&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;base.py:56-131&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;implement() = snapshot .snodo/ by CONTENT (it is gitignored, so git cannot see it) → _implement_in_place(spec) → diff; any change raises SnodoMutationError → blocker halt + audit entry.&lt;br&gt;&lt;b&gt;Lives in the base class so it cannot be forgotten by a future adapter (ADR 026/027).&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="720" y="270" width="620" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c3occli" value="&lt;b&gt;OpenCodeCLIAdapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;opencode_cli_adapter.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;br&gt;host subprocess:&lt;br&gt;opencode run --dir … -m ‹model›&lt;br&gt;permissions skipped · timeout 1800s&lt;br&gt;&lt;br&gt;readback: git working-tree diff + untracked&lt;br&gt;&lt;b&gt;commits itself&lt;/b&gt; with an exclude pathspec&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B1D8F5;strokeColor=#5D82A8;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="720" y="450" width="290" height="170" as="geometry" />
        </mxCell>
        <mxCell id="c3occont" value="&lt;b&gt;OpenCodeAdapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;opencode_adapter.py + opencode_container.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Docker container running `opencode serve`, workspace bind-mounted&lt;br&gt;POST /session · SSE /event · POST /message&lt;br&gt;wait session.idle · timeout 300s&lt;br&gt;&lt;br&gt;readback: git working-tree diff, fallback GET /session/{id}/diff&lt;br&gt;&lt;b&gt;does NOT commit&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B1D8F5;strokeColor=#5D82A8;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="1050" y="450" width="290" height="170" as="geometry" />
        </mxCell>

        <mxCell id="c3e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3sel" target="c3abc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=none;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3abc" target="c3flags">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3litellm" target="c3abc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="350" y="240" />
              <mxPoint x="570" y="240" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c3e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3inplace" target="c3abc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1030" y="240" />
              <mxPoint x="750" y="240" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c3e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3occli" target="c3inplace">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="865" y="420" />
              <mxPoint x="875" y="420" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c3e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3occont" target="c3inplace">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1195" y="420" />
              <mxPoint x="1185" y="420" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="c3gapT" value="TWO CHANNELS FOR &quot;WHAT CHANGED&quot; — WHERE THE DIVERGENCE BITES" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#B85450;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="670" width="800" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c3ch1" value="&lt;b&gt;Channel A — CodeArtifact&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Returned by the adapter.&lt;br&gt;· LiteLLM → submit_files arguments&lt;br&gt;· opencode CLI → working-tree git diff&lt;br&gt;· opencode container → working-tree git diff, /diff fallback&lt;br&gt;&lt;br&gt;&lt;b&gt;All adapters populate this. Works uncommitted.&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c3ch2" value="&lt;b&gt;Channel B — git diff HEAD~1..HEAD&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Read by post-execute validators and pasted into the judge prompt as &quot;## Code Change&quot;.&lt;br&gt;llm_validator.py:235,414 · acceptance.py:94&lt;br&gt;&lt;br&gt;· LiteLLM → executor commits ✔&lt;br&gt;· opencode CLI → adapter commits ✔&lt;br&gt;· opencode container → &lt;b&gt;nobody commits ✘&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="480" y="700" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c3ch3" value="&lt;b&gt;Consequence&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;HEAD never moves, so HEAD~1..HEAD resolves to the &lt;b&gt;previous&lt;/b&gt; commit — a valid diff of the wrong change.&lt;br&gt;&lt;br&gt;Validators do not fail. They confidently review someone else's work labelled as this task's, and pass.&lt;br&gt;&lt;br&gt;Already neutered arm-c review in EXP1.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="920" y="700" width="420" height="130" as="geometry" />
        </mxCell>

        <mxCell id="c3drift" value="&lt;b&gt;Drift ledger — which gaps are snodo's problem and which are not&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;br&gt;&lt;b&gt;The CLI's business — correctly absent from the opencode adapters:&lt;/b&gt; turn-level progress · truncation detection · context management · turn budgets. opencode owns its own agent loop; snodo re-implementing these would undo the delegation that is the entire point of the seam.&lt;br&gt;&lt;br&gt;&lt;b&gt;snodo's business — genuinely missing:&lt;/b&gt;&lt;br&gt;① the container path never commits, so Channel B starves and validators review the wrong change&lt;br&gt;② &quot;coder produced nothing&quot; is downgraded from ExecutionError to an audit note whenever skip_engine_commit is set (executor.py:52-59) — it fails loudly on litellm and continues quietly on opencode&lt;br&gt;③ no usage or cost record, so an opencode run's spend is absent from the audit trail&lt;br&gt;④ neither adapter's tests were updated by #51, #52 or #53 (last touched 2026-06-30)&lt;br&gt;⑤ opencode_container.py untouched on its own merits since 2026-06-26&lt;br&gt;&lt;br&gt;&lt;b&gt;Root cause:&lt;/b&gt; the seam is implicit — an ABC, two opt-out booleans and hasattr duck typing. Opting out of a mechanism carries no obligation to discharge what that mechanism did, and a capability an adapter lacks is indistinguishable from one that does not exist. Divergence is undetectable by construction.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="860" width="1300" height="215" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="c4-l3-engine" name="L3 · Execution Engine">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="e3t" value="L3 · Execution Engine  (snodo.engine)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="e3s" value="A LangGraph state machine over LoopState, checkpointed to SQLite so a session is resumable (INV5)." style="text;html=1;fontSize=12;fontColor=#555555;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1000" height="20" as="geometry" />
        </mxCell>

        <mxCell id="e3gov" value="&lt;b&gt;1 · Governance&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;nodes/governance.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;br&gt;iteration++ (cap 50) · decision records · coder respawn on verified set_model · message summarisation · wave classification (turn 1) · environment preparation (turn 1) · spec-authoring re-entry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="e3pre" value="&lt;b&gt;2 · Pre-execute validation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;nodes/validation.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Judges the PROPOSAL: meta-spec · security · architecture.&lt;br&gt;&lt;br&gt;Issues a validation token (INV1). Disagreement policy → proceed / escalate / blocker.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="345" y="110" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="e3exec" value="&lt;b&gt;3 · Execute&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;nodes/executor.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Injects progress_callback and job/task ids (hasattr-guarded) · calls coder.implement() · writes artifacts via WorkspaceMCP unless skip_workspace_write · stages and commits via GitMCP unless skip_engine_commit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="650" y="110" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="e3post" value="&lt;b&gt;4 · Post-execute validation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;nodes/validation.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Judges the ARTIFACTS: quality (runs the test command) and acceptance (completeness vs the spec).&lt;br&gt;&lt;br&gt;Reads the change via HEAD~1..HEAD.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="955" y="110" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="e3wb" value="&lt;b&gt;5 · Writeback&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;nodes/writeback.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Halt payload · _build_hint naming only the applicable fix targets — code / spec / policy (#38) · auto_merge when enabled · worktree cleanup only after a successful merge&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="1260" y="110" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="e3f1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e3gov" target="e3pre"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3f2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e3pre" target="e3exec"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3f3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e3exec" target="e3post"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3f4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e3post" target="e3wb"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e3f5" value="recovery subtask — a fix task re-enters at governance, bounded by max_recovery_depth" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;dashed=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;verticalAlign=top;" edge="1" parent="1" source="e3post" target="e3gov">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1095" y="300" />
              <mxPoint x="180" y="300" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e3state" value="&lt;b&gt;LoopState&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;engine/state.py — task · mode · iteration · messages · artifacts · validation_results · validation_token · halt_type · metadata · recovery bookkeeping&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="335" width="700" height="55" as="geometry" />
        </mxCell>
        <mxCell id="e3ckpt" value="&lt;b&gt;SqliteSaver checkpoint&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;persists LoopState per thread (INV5)&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="770" y="330" width="360" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e3audit" value="&lt;b&gt;AuditLog&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;hash-chained JSONL (INV4); entries record the active mode&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="1160" y="330" width="380" height="65" as="geometry" />
        </mxCell>

        <mxCell id="e3pol" value="&lt;b&gt;PolicyEngine&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;engine/policy.py — aggregates verdicts under the disagreement policy into proceed · escalate · blocker&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e3con" value="&lt;b&gt;ConstraintEngine&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;engine/constraints.py + snodo.predicates — global constraints against workspace and git state. Non-overridable blockers (INV3).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="420" y="420" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e3clo" value="&lt;b&gt;Closure / recovery&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;engine/closure.py — per-branch max_recovery_depth (per-mode override, ADR 029) · max_total_fix_attempts · stall detection on repeated identical verdicts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="800" y="420" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e3prog" value="&lt;b&gt;progress.py&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;format_elapsed · format_tool_call_summary. Node transitions and per-turn coder/validator progress (#28, #51).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="1180" y="420" width="360" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e3halt" value="&lt;b&gt;Halt classification — four outcomes, invariant across the return path:&lt;/b&gt;  halt_type == final_decision == raw_halt_type" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;verticalAlign=middle;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e3h1" value="&lt;b&gt;escalate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;A judgement the operator must make.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="585" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e3h2" value="&lt;b&gt;blocker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;A non-overridable refusal (INV3). Includes .snodo/ mutation by an in-place coder.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="420" y="585" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e3h3" value="&lt;b&gt;validator_error&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;An operational fault (e.g. environment prep failed). Does NOT spawn recovery — #27.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="800" y="585" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e3h4" value="&lt;b&gt;internal_error&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;The engine itself failed. &lt;b&gt;Open defect:&lt;/b&gt; observed leaking a second, unclassified &quot;unknown internal error&quot; after a complete payload.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1180" y="585" width="360" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e3note" value="&lt;b&gt;Where the enforcement actually lives.&lt;/b&gt; Capability is bound at the tool surface — WorkspaceMCP and GitMCP refuse out-of-bounds paths — not in the coder. That is precisely why an untrusted third-party generator is architecturally acceptable, and why the container adapter's silent starving of the post-execute change channel is the serious defect rather than any of its missing conveniences." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;spacing=8;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="695" width="1500" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="c4-l3-validators" name="L3 · Validator Subsystem">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="v3t" value="L3 · Validator Subsystem  (snodo.validators)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="v3s" value="Policy is data: which validators run, in which phase, with what severity cap and tool grant, is declared in the protocol — not in code." style="text;html=1;fontSize=12;fontColor=#555555;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1100" height="20" as="geometry" />
        </mxCell>

        <mxCell id="v3run" value="&lt;b&gt;ValidatorRunner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;runner.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Resolves the mode's validator list for the phase · builds ValidatorContext · runs each · applies severity_cap · enriches justifications with cited criterion text (#37) · returns results to the PolicyEngine&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="v3ctx" value="&lt;b&gt;ValidatorContext&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;context.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;br&gt;task spec · artifacts · mode · progress_callback · tool handles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="290" height="150" as="geometry" />
        </mxCell>
        <mxCell id="v3reg" value="&lt;b&gt;registry.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;validator_type → class&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;br&gt;architecture · security · quality · acceptance · protocol_adherence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="760" y="100" width="290" height="150" as="geometry" />
        </mxCell>

        <mxCell id="v3judge" value="JUDGES — read-only, no execution" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontColor=#5D82A8;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="500" height="20" as="geometry" />
        </mxCell>
        <mxCell id="v3llm" value="&lt;b&gt;LLMValidator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;llm_validator.py — bounded tool loop, ≤20 turns&lt;br&gt;&lt;br&gt;tools: read_file · read_file_lines · list_files · diff_between_refs&lt;br&gt;terminal: submit_verdict(severity, justification)&lt;br&gt;&lt;br&gt;Prompt is handed &quot;## Code Change (HEAD~1..HEAD)&quot; — lines 235 / 414.&lt;br&gt;Fails closed. Every tool_call_id answered (#53).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B1D8F5;strokeColor=#5D82A8;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="330" height="170" as="geometry" />
        </mxCell>

        <mxCell id="v3arch" value="&lt;b&gt;architecture&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;pre-execute. REVIEW FRAME criterion stops it citing absent implementation. Reads docs/decisions/.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B1D8F5;strokeColor=#5D82A8;verticalAlign=top;spacing=6;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="320" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v3sec" value="&lt;b&gt;security&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;pre-execute. Encoding boundaries · personal-data sinks · credentials · dependency additions.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B1D8F5;strokeColor=#5D82A8;verticalAlign=top;spacing=6;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="395" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v3meta" value="&lt;b&gt;meta-spec&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;pre-execute, judges_spec: true — sees the spec only. Rejects code-prescriptive specs; gates the spec-authoring rewriter (ADR 023).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B1D8F5;strokeColor=#5D82A8;verticalAlign=top;spacing=6;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="470" width="330" height="65" as="geometry" />
        </mxCell>
        <mxCell id="v3acc" value="&lt;b&gt;acceptance&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;post-execute, NEW (ADR 028). Judges completeness against the spec's acceptance criteria. MET / UNMET / UNCHECKABLE — uncheckable is a pass by construction. severity_cap: warn.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B1D8F5;strokeColor=#5D82A8;verticalAlign=top;spacing=6;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="550" width="330" height="75" as="geometry" />
        </mxCell>

        <mxCell id="v3exe" value="EXECUTOR — the only validator that runs something" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="600" height="20" as="geometry" />
        </mxCell>
        <mxCell id="v3q" value="&lt;b&gt;quality&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;quality.py — post-execute&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Runs the protocol's tooling.test_command via ShellMCP and reports exit code and output. Auto-detects the command from marker files when unset (#33). Typically severity_cap: warn so a failure routes to recovery.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="330" height="130" as="geometry" />
        </mxCell>

        <mxCell id="v3pa" value="&lt;b&gt;protocol_adherence&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;checks the run against the protocol's own rules&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B1D8F5;strokeColor=#5D82A8;verticalAlign=top;spacing=6;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="320" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v3pol" value="&lt;b&gt;Disagreement policy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;unanimous (shipped default) — every validator must pass.&lt;br&gt;&lt;br&gt;With a single post-execute validator this is an &lt;b&gt;unopposed veto&lt;/b&gt;: there is nothing to disagree with it (#41).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;spacing=6;align=left;" vertex="1" parent="1">
          <mxGeometry x="880" y="395" width="290" height="130" as="geometry" />
        </mxCell>

        <mxCell id="v3e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=blockThin;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3run" target="v3ctx"><mxGeometry relative="1" as="geometry" /></mxCell>
