    "required": [
      "session_id",
      "project_id",
      "scope",
      "display_name",
      "run_started_at",
      "plans",
      "tasks",
      "jobs",
      "task_status_counts",
      "job_status_counts",
      "last_event",
      "last_activity_at",
      "snapshot_at"
