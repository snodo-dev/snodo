{
  "$schema": "https://opencode.ai/config.json",
  // Auto-compaction is required, not optional: without it a large reading
  // surface fills the context and the run degrades into planning instead of
  // editing, or stalls until the caller's timeout. Matches the local-ollama
  // config this was modelled on.
  "compaction": {
    "auto": true,
    "threshold": 0.7
  },
  // Ollama Cloud (https://ollama.com/v1). Model ids are the unversioned
  // aliases; the endpoint also serves pinned ids (deepseek-v4-flash:0731,
  // deepseek-v4-pro:0813) if a run needs to be reproducible against one
  // snapshot. Key comes from OLLAMA_API_KEY — never inline it here, this
  // file is tracked.
  "provider": {
    "ollama-cloud": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Cloud",
      "options": {
        "baseURL": "https://ollama.com/v1",
        "apiKey": "{env:OLLAMA_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash (Ollama Cloud)", "tools": true },
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro (Ollama Cloud)", "tools": true },
        "kimi-k2.7-code": { "name": "Kimi K2.7 Code (Ollama Cloud)", "tools": true },
        "qwen3.5:397b": { "name": "Qwen3.5 397B (Ollama Cloud)", "tools": true },
        "glm-5.3-flash": { "name": "GLM 5.3 Flash (Ollama Cloud)", "tools": true }
      }
    }
  }
}
